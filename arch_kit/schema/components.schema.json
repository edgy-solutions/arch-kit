{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component record",
  "description": "One list of components: the parts of a system, each with its purpose, wiring, sign-in and data path, and the evidence for it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["components"],
  "properties": {
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}}
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {"pattern": "[\\r\\n]"}
    },
    "line": {
      "type": "string",
      "pattern": "\\S",
      "not": {"pattern": "[\\r\\n]"}
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "purpose", "plane", "wiring", "sign_in", "data_path", "serves", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^CO-[A-Z0-9]+(-[A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}},
        "name": {"$ref": "#/$defs/name"},
        "purpose": {"$ref": "#/$defs/line"},
        "plane": {"$ref": "#/$defs/name"},
        "wiring": {"$ref": "#/$defs/line"},
        "sign_in": {"$ref": "#/$defs/line"},
        "data_path": {"$ref": "#/$defs/line"},
        "serves": {"type": "array", "items": {"$ref": "#/$defs/line"}},
        "status": {"enum": ["measured", "built", "accepted", "proposed"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "connections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/connection"}}
      }
    },
    "oneline": {"type": "string", "not": {"pattern": "[\\r\\n]"}},
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["other", "direction", "protocol", "sign_in", "what_passes", "status", "evidence"],
      "properties": {
        "other": {"$ref": "#/$defs/oneline"},
        "direction": {"enum": ["calls", "is called by", "reads", "writes"]},
        "protocol": {"$ref": "#/$defs/line"},
        "sign_in": {"$ref": "#/$defs/line"},
        "what_passes": {"$ref": "#/$defs/line"},
        "status": {"enum": ["measured", "built", "accepted", "proposed"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "protected_by": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/protection"}}
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "by": {"$ref": "#/$defs/oneline"},
        "none": {"$ref": "#/$defs/line"},
        "status": {"enum": ["measured", "built", "accepted", "proposed"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "oneOf": [{"required": ["by"]}, {"required": ["none"]}]
    }
  }
}
